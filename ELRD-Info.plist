<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ergänzt die von Xcode erzeugte Info.plist (GENERATE_INFOPLIST_FILE). Liegt bewusst
	     außerhalb des Ordners ELRD/, sonst würde sie als Ressource mitkopiert. -->
	<!-- Nur Standard-Verschlüsselung von Apple (HTTPS, Dateischutz, CryptoKit): keine Exportanmeldung nötig. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Einsatzdatei (Schritt 63): „Öffnen in ELRD“ aus AirDrop, Mail und Dateien. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.elrd.einsatz</string>
			<key>UTTypeDescription</key>
			<string>ELRD-Einsatz</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>elrdeinsatz</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ELRD-Einsatz</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.elrd.einsatz</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Abgleich vor Ort (Schritt 66, MultipeerConnectivity); Schritt 140: ELRD-Backend im lokalen Netz. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Gleicht Einsätze mit iPads in der Nähe ab und erreicht ein ELRD-Backend im eigenen Netz.</string>
	<!-- Schritt 140: ELRD-Backend zum Testen ohne HTTPS nur im lokalen Netz; sonst gilt HTTPS.
	     Seit iOS 17 sperrt ATS http:// zu IP-Adressen; daher private Bereiche und
	     100.64.0.0/10 (Tailscale/CGNAT) als CIDR-Ausnahme (E128). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>10.0.0.0/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>172.16.0.0/12</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>192.168.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- iCloud-Teilen: Einladungslinks öffnen ELRD; stille Push-Mitteilungen bei Änderungen. -->
	<key>CKSharingSupported</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- NFC-Anhängekarten (Schritt 110): Text/Link auf der Karte oder Seriennummer des Chips. -->
	<key>NFCReaderUsageDescription</key>
	<string>Patientenanhängekarten mit NFC-Chip lesen.</string>
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>D2760000850101</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_elrd-sync._tcp</string>
		<string>_elrd-sync._udp</string>
	</array>
</dict>
</plist>
