<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud-Teilen (CloudKit). Liegt außerhalb von ELRD/, damit es nicht als Ressource kopiert wird. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.ELRD.App</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<!-- iCloud Drive der App: GPX für Hundeteams per Link (Schritt 120). -->
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.ELRD.App</string>
	</array>
	<!-- Stille Push-Mitteilungen bei Änderungen (wird beim Export auf „production“ gesetzt). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- NFC-Anhängekarten lesen (Schritt 110, nur iPhone). -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
