# Kopieren nach .env und ausfüllen. .env nie einchecken.

# Admin-Schlüssel für Verwaltung und Debug-Seite (mind. 16 Zeichen), z. B. openssl rand -base64 24
Elrd__Admin__Key=

# Zugang des Backends zum Broker (Benutzer in mosquitto/passwd anlegen)
Elrd__Mqtt__Username=elrd-backend
Elrd__Mqtt__Password=

# Datei verschlüsseln (32 Byte, Base64): openssl rand -base64 32
Elrd__Storage__EncryptionKey=

# Aufbewahrung in Stunden nach der letzten Änderung
Elrd__Retention__Hours=24

# Testeinsätze/Debug – im Echtbetrieb false
Elrd__Debug__Enabled=false
