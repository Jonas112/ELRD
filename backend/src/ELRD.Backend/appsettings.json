{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Elrd": {
    "Mqtt": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 8883,
      "UseTls": true,
      "AllowUntrustedCertificates": false,
      "Username": "",
      "Password": "",
      "ClientId": "elrd-backend",
      "TopicPrefix": "elrd",
      "KeepAliveSeconds": 30
    },
    "Storage": {
      "DataDirectory": "data",
      "EncryptionKey": ""
    },
    "Admin": {
      "Key": ""
    },
    "Debug": {
      "Enabled": false
    },
    "Retention": {
      "Hours": 24
    }
  }
}
