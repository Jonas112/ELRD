<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests ohne Test-Framework (keine NuGet-Pakete, E123): kleine Konsolen-App,
    die alle Prüfungen ausführt und bei einem Fehler mit Code 1 endet.
    Ausführen: dotnet run im Ordner tests/ELRD.Backend.Tests
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ElrdBackend.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\ELRD.Backend\ELRD.Backend.csproj" />
  </ItemGroup>

</Project>
